# Required
ADMIN_PASS=change-this-to-a-strong-password
SECRET_KEY=generate-with-python3-c-import-secrets-print-secrets-token-hex-32

# Optional: Azure SPN for Resource Health checks (certificate-based auth)
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-app-registration-client-id
# AZURE_CLIENT_CERTIFICATE_PATH=/home/pi/status-page/certs/azure-monitor.pfx
# AZURE_SUBSCRIPTION_ID=your-subscription-id

# Optional: Alert integrations
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# JIRA_URL=https://your-org.atlassian.net
# JIRA_USER=user@example.com
# JIRA_TOKEN=your-api-token
# JIRA_PROJECT=OPS
